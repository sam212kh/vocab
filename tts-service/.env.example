# Bind to loopback; expose through HTTPS reverse proxy only.
TTS_HOST=127.0.0.1
TTS_PORT=8787
# google uses the unofficial Google Translate "listen" endpoint: no API key, no SLA,
# can be rate-limited or blocked by Google without notice. Use piper for a self-hosted
# fallback with no external dependency.
TTS_PROVIDER=google
TTS_GOOGLE_LANG=en
# Comma-separated exact browser origins, or * to allow any origin.
TTS_ALLOWED_ORIGINS=*
TTS_CACHE_DIR=/var/cache/english-upgrade-tts
TTS_CACHE_TTL_DAYS=180
TTS_MAX_CACHE_MB=2048
TTS_MAX_CHARS=1200
TTS_TIMEOUT_MS=12000
TTS_RATE_LIMIT_PER_MINUTE=30
FFMPEG_BIN=/usr/bin/ffmpeg

# Used only when TTS_PROVIDER=piper.
TTS_PIPER_VOICES=en_US-lessac-high=/opt/piper/voices/en_US-lessac-high.onnx,en_US-ryan-high=/opt/piper/voices/en_US-ryan-high.onnx
PIPER_BIN=/opt/piper/venv/bin/piper

# Create a Speech resource in Azure AI Foundry and configure the region and key.
# Keep this file readable only by the service account. Never use VITE_ prefixes.
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_KEY=replace-with-secret
