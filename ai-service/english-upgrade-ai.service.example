[Unit]
Description=English Upgrade AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=english-ai
Group=english-ai
WorkingDirectory=/opt/english-upgrade/ai-service
EnvironmentFile=/etc/english-upgrade-ai.env
ExecStart=/usr/bin/node /opt/english-upgrade/ai-service/server.mjs
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The assessment module persists session files here; with ProtectSystem=strict
# the service can write NOWHERE else. Must match ASSESSMENT_STATE_DIR, and the
# directory must exist and be owned by the service user:
#   sudo install -d -o english-ai -g english-ai -m 0750 /var/lib/english-upgrade-assessment
ReadWritePaths=/var/lib/english-upgrade-assessment
ProtectHome=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
