# ---- Server (safe to tune) ----
# Bind to loopback; expose only through the HTTPS reverse proxy.
AI_HOST=127.0.0.1
AI_SERVICE_PORT=8788
# Comma-separated exact browser origins, or * (see README: origins are NOT authentication).
AI_ALLOWED_ORIGINS=https://your-app-hostname.example
# Default provider: ollama | cloud
AI_PROVIDER=ollama
# Explicit fallback provider when the primary fails AND the client sent allowFallback:true.
# Empty disables fallback entirely. Learner text is sent to this provider when used.
AI_FALLBACK_PROVIDER=
AI_REQUEST_TIMEOUT_MS=90000
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_BODY_BYTES=65536
AI_MAX_SUBMISSION_CHARS=8000
AI_MAX_RESPONSE_CHARS=60000
AI_MAX_REPAIR_ATTEMPTS=1

# ---- Ollama (local provider) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Models the UI may offer (comma-separated). Only these can be requested by clients.
OLLAMA_MODELS=qwen2.5:7b-instruct,llama3.1:8b
# Set to 0 if the chosen model misbehaves with format:"json".
OLLAMA_JSON_MODE=1

# ---- Cloud (OpenAI-compatible chat-completions API) ----
# SERVER-SIDE SECRETS. Keep this file readable only by the service account.
# Never use VITE_ prefixes — anything VITE_* is bundled into public frontend assets.
CLOUD_API_BASE_URL=https://api.example.com/v1
CLOUD_API_KEY=replace-with-secret
CLOUD_MODEL=replace-with-model-id
CLOUD_MODELS=replace-with-model-id
CLOUD_WIRE_FORMAT=openai-chat
CLOUD_JSON_MODE=1
